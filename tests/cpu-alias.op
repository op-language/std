//! Test: the `cpu` alias resolves to the selected CPU module.
//!
//! Build with any target, e.g. mos6502-nintendo-nes-ntsc.

use std::*;

// These consts are only valid if `cpu` is an alias for the selected CPU
// module. cpu::a resolves to the selected CPU's CPU_REG::a variant.
#[cfg(cpu = "mos6502")]
const _TEST_CPU_ALIAS: u8 = cpu::a;

#[cfg(cpu = "w65c02")]
const _TEST_CPU_ALIAS_W65C02: u8 = cpu::a;