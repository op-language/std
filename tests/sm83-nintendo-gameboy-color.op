//! Test: sm83-nintendo-gameboy-color
//!
//! Verifies that the cfg predicates for cpu, manufacturer, machine,
//! variant, and target match the triplet sm83-nintendo-gameboy-color.
//! The parser splits the triplet into machine = "gameboy" and
//! variant = "color".

use std::*;

#[cfg(cpu = "sm83")]
const _TEST_CPU: u8 = 0;

#[cfg(manufacturer = "nintendo")]
const _TEST_MFR: u8 = 0;

#[cfg(machine = "gameboy")]
const _TEST_MACHINE: u8 = 0;

#[cfg(variant = "color")]
const _TEST_VARIANT: u8 = 0;

#[cfg(target = "sm83-nintendo-gameboy-color")]
const _TEST_TARGET: u8 = 0;