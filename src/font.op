//! Font Module
//!
//! Cross-platform font loading and text display for the NES, the DMG, and
//! the GBC. The `pub use font::*` re-export flattens the selected platform
//! module so `font_load` and `draw_text` work directly.
//!
//! See `docs/FONT_REFERENCE.md` for the binary font format specification.

mod types;
mod ram;
mod api;
mod data;

#[cfg(machine = "nes")]
mod nes;

#[cfg(machine = "gameboy")]
mod gameboy;

#[cfg(machine = "nes")]
pub use nes::*;

#[cfg(machine = "gameboy")]
pub use gameboy::*;

pub use api::*;
pub use types::*;
pub use data::*;