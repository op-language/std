// --- CPU alias: the selected CPU module is available as `cpu` ---------------

#[cfg(cpu = "mos6502")]
pub use mos6502 as cpu;

#[cfg(cpu = "mos65sc02")]
pub use mos65sc02 as cpu;

#[cfg(cpu = "wdc65c816")]
pub use wdc65c816 as cpu;

#[cfg(cpu = "m68000")]
pub use m68000 as cpu;

#[cfg(cpu = "z80")]
pub use z80 as cpu;

// --- Machine alias: the selected machine module is available as `machine` ---

