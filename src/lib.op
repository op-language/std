//! Op Standard Library
//!
//! This lib supplies the CPU and the platform definitions for all
//! supported targets. The #[cfg()] attribute selects the correct code
//! for the target triplet. The `pub use ... as cpu;` and
//! `pub use ... as machine;` aliases expose the selected CPU and
//! machine under a stable name.

// --- CPU modules (cfg-selected) --------------------------------------------

#[cfg(cpu = "mos6502")]
mod mos6502;

#[cfg(cpu = "mos65sc02")]
mod mos65sc02;

#[cfg(cpu = "wdc65c816")]
mod wdc65c816;

#[cfg(cpu = "m68000")]
mod m68000;

#[cfg(cpu = "z80")]
mod z80;

// --- Machine modules (cfg-selected) ----------------------------------------

#[cfg(machine = "nes")]
mod nes;

#[cfg(machine = "lynx")]
mod lynx;

#[cfg(machine = "apple-ii")]
mod apple_ii;

#[cfg(machine = "apple-iic")]
mod apple_iic;

#[cfg(machine = "apple-iie")]
mod apple_iie;

#[cfg(machine = "apple-iie-enhanced")]
mod apple_iie_enhanced;

#[cfg(machine = "atari-800")]
mod atari_800;

#[cfg(machine = "atari-2600")]
mod atari_2600;

#[cfg(machine = "atari-5200")]
mod atari_5200;

#[cfg(machine = "atari-7800")]
mod atari_7800;

#[cfg(machine = "commodore-64")]
mod commodore_64;

#[cfg(machine = "pcengine")]
mod pcengine;

#[cfg(machine = "neogeo-aes")]
mod neogeo_aes;

#[cfg(machine = "sega-genesis")]
mod sega_genesis;

#[cfg(machine = "apple-iigs")]
mod apple_iigs;

#[cfg(machine = "snes")]
mod snes;

#[cfg(machine = "gameboy")]
mod gameboy;

#[cfg(machine = "gameboy-color")]
mod gameboy_color;

#[cfg(machine = "gamegear")]
mod gamegear;

#[cfg(machine = "mastersystem")]
mod mastersystem;

