//! Font Text Display — Game Boy
//!
//! Text display functions for the Game Boy and Game Boy Color. Writes
//! tile indices to the tile map at 0x9800. The cursor position is
//! tracked in `_cursor_x` and `_cursor_y`.
//!
//! All functions use only the working SM83 subset (ld #n, ld_a (nn),
//! ld_addr (nn), ldh #n, ldh (n), ld_hl/ld_de/ld_bc #nn, ld_a_hl/
//! ld_a_bc/ld_a_de, ld_ba/ld_ca/ld_ab/ld_ac, inc_hl/inc_de/inc_bc,
//! ldi, cpl, dec, cp, do/while, if, loop, jp).
//!
//! Long loops live in non-inline fns (single copy in ROM, e.g.
//! _dt_loop, _fls_loop): inline fn labels are section-global and
//! collide across inlined copies, and do-while back-jumps are
//! relative JRs with a 128-byte reach.
//!
//! Compiler constraints (opc 0.10.0):
//!
//! - `if ... else` and `while` emit a 6502-style JMP (0x4C) on SM83
//!   instead of JP (0xC3). Never use if-else or while here; use
//!   `if` without an else block plus explicit `jp` labels.
//! - `ld_a (expr)` on a const expression loads from memory address
//!   `expr`, not the value. Use `ld #expr` to load a const value.
//! - A loop's `if (zero)` guard must be preceded by an explicit `cp #0`
//!   of the counter value; stale flags are not reliable.

use super::types::*;
use super::ram::*;
use std::machine::*;

// --- Temp variables ---------------------------------------------------------

_putchar_char: u8;
_draw_text_ptr_lo: u8;
_draw_text_ptr_hi: u8;
_draw_text_len: u8;
_ft_outer: u8;
_ft_inner: u8;
// Slot counter for font_load_string. Dedicated: the generic scratch
// bytes are reused as loop counters inside the per-character loop.
_fls_slot: u8;

// --- Remap table ------------------------------------------------------------
//
// Maps a character code (0x00-0x7F) to the absolute VRAM tile slot that
// holds the current font's glyph for that character. 0xFF means the
// entry is unset. Written by font_load and font_load_string, read by
// draw_text and putchar.

_tile_remap: [u8; 128];

// --- Remap table initialization ---------------------------------------------

inline fn font_init_remap() {
    // Fill _tile_remap with 0xFF (unset).
    ld_hl #_tile_remap
    ld #128
    ld_addr (_ft_outer)
    do {
        ld #0xFF
        ldi
        ld_a (_ft_outer)
        dec
        ld_addr (_ft_outer)
    } while (not zero)
}

// --- Game Boy runtime tile loader -------------------------------------------
//
// Copies 1bpp tile data from ROM to VRAM, expanding each row to 2bpp.
// The font blob is: [flags][tile_count][enc_table][1bpp_tiles].
// The tile data starts at offset 2 + enc_table_size, where enc_table_size
// is 256 (ENCODE_256), 128 (ENCODE_128), or 0 (ENCODE_NONE).
//
// The 2bpp expansion for fg=0, bg=3 is: plane0 = plane1 = ~row (CPL).
// Other fg/bg combinations are not yet supported.

inline fn _font_load_tiles(first, count, data) {
    // Turn the LCD off before writing VRAM.
    ld #0
    ldh (LCD::CONTROL)
    // HL = VRAM pattern table at 0x8000 + first*16.
    ld_hl #0x8000
    ld_a (first)
    cp #0
    if (zero) { jp 'flt_off_done' }
    ld_addr (_ft_outer)
    do {
        ld #16
        ld_addr (_ft_inner)
        do {
            inc_hl
            ld_a (_ft_inner)
            dec
            ld_addr (_ft_inner)
        } while (not zero)
        ld_a (_ft_outer)
        dec
        ld_addr (_ft_outer)
    } while (not zero)
    'flt_off_done:
    // DE = font data blob address.
    ld_de #data
    // Skip the header (2 bytes) + encoding table. The flags byte
    // lower 2 bits select the mode: bit 1 set = ENCODE_NONE (skip
    // 2); bit 0 set = ENCODE_128 (skip 130); else ENCODE_256 (skip
    // 258). No if-else: the compiler emits a 0x4C JMP on SM83.
    ld_a_de
    and #2
    if (zero) { jp 'flt_not_none' }
    inc_de
    inc_de
    jp 'flt_skip_done'
    'flt_not_none:
    ld_a_de
    and #1
    if (zero) { jp 'flt_enc256' }
    // ENCODE_128: skip 128 table bytes.
    ld #128
    ld_addr (_ft_outer)
    do {
        inc_de
        ld_a (_ft_outer)
        dec
        ld_addr (_ft_outer)
    } while (not zero)
    inc_de
    inc_de
    jp 'flt_skip_done'
    'flt_enc256:
    // ENCODE_256: skip 256 table bytes (counter 0 wraps to 255).
    ld #0
    ld_addr (_ft_outer)
    do {
        inc_de
        ld_a (_ft_outer)
        dec
        ld_addr (_ft_outer)
    } while (not zero)
    inc_de
    inc_de
    'flt_skip_done:
    // Now DE points to the first 1bpp tile. Copy count tiles,
    // expanding each row from 1bpp to 2bpp. ld #count loads the
    // const tile count as an immediate (ld_a (count) would load
    // from the memory address held in count).
    ld #count
    ld_addr (_ft_outer)
    do {
        // Inner loop: 8 rows per tile.
        ld #8
        ld_addr (_ft_inner)
        do {
            // Read 1bpp row byte.
            ld_a_de
            inc_de
            // Expand to 2bpp: plane0 = plane1 = row (ink -> colour 3,
            // paper -> colour 0), giving dark text on a light background.
            ldi
            // Write plane 1 (same value) to VRAM.
            // A still holds the row value (ldi doesn't change A).
            ldi
            // Decrement row counter.
            ld_a (_ft_inner)
            dec
            ld_addr (_ft_inner)
        } while (not zero)
        // Decrement tile counter.
        ld_a (_ft_outer)
        dec
        ld_addr (_ft_outer)
    } while (not zero)
}

// --- Cursor positioning -----------------------------------------------------

inline fn gotoxy(x, y) {
    assign(_cursor_x, x)
    assign(_cursor_y, y)
}

// --- Character output -------------------------------------------------------
//
// putchar writes the character in _putchar_char to the tile map at the
// cursor position. The tile index comes from _tile_remap[_putchar_char]
// when that entry is set; otherwise it falls back to
// _putchar_char + first_tile.
//
// The tile map address is TILE_MAP_0_ADDRESS + _cursor_y * 32 + _cursor_x.
// The remap lookup uses HL, so it runs before the map address is set up.

inline fn putchar(c) {
    assign(_putchar_char, c)

    // Tile index: _tile_remap[char] when the entry is set, else the
    // legacy char + first_tile. The result lands in _putchar_char.
    ld_a (_putchar_char)
    cp #128
    if (carry) { jp 'pc_remap' }
    jp 'pc_legacy'
    'pc_remap:
    cp #0
    if (zero) { jp 'pc_remap_done' }
    ld_addr (_ft_outer)
    ld_hl #_tile_remap
    do {
        inc_hl
        ld_a (_ft_outer)
        dec
        ld_addr (_ft_outer)
    } while (not zero)
    'pc_remap_done:
    ld_a_hl
    cp #0xFF
    if (zero) { jp 'pc_legacy' }
    ld_addr (_putchar_char)
    jp 'pc_tile_done'
    'pc_legacy:
    // Legacy: _putchar_char = _putchar_char + first_tile.
    ld_a (_font_current + 2)
    cp #0
    if (zero) { jp 'pc_tile_done' }
    ld_a (_font_current + 2)
    ld_addr (_ft_outer)
    do {
        ld_a (_putchar_char)
        add #1
        ld_addr (_putchar_char)
        ld_a (_ft_outer)
        dec
        ld_addr (_ft_outer)
    } while (not zero)
    'pc_tile_done:

    // Set HL = 0x9800 + _cursor_y * 32 + _cursor_x.
    // Start at 0x9800, add _cursor_y * 32, then add _cursor_x.
    ld_hl #0x9800
    // Add _cursor_y * 32 (skipped when _cursor_y is 0).
    ld_a (_cursor_y)
    cp #0
    if (zero) { jp 'pc_y_done' }
    ld_addr (_ft_outer)
    do {
        // HL += 32 as 32 iterations of inc_hl (no add hl, #32 in the
        // working subset).
        ld #32
        ld_addr (_ft_inner)
        do {
            inc_hl
            ld_a (_ft_inner)
            dec
            ld_addr (_ft_inner)
        } while (not zero)
        ld_a (_ft_outer)
        dec
        ld_addr (_ft_outer)
    } while (not zero)
    'pc_y_done:

    // Add _cursor_x to HL (skipped when _cursor_x is 0).
    ld_a (_cursor_x)
    cp #0
    if (zero) { jp 'pc_x_done' }
    ld_addr (_ft_outer)
    do {
        inc_hl
        ld_a (_ft_outer)
        dec
        ld_addr (_ft_outer)
    } while (not zero)
    'pc_x_done:

    // A = tile index. Write to (HL) via ldi.
    ld_a (_putchar_char)
    ldi

    // Advance the cursor X. Wrap at 32.
    ld_a (_cursor_x)
    inc
    ld_addr (_cursor_x)
    cp #32
    if (not carry) {
        assign(_cursor_x, 0)
        ld_a (_cursor_y)
        inc
        ld_addr (_cursor_y)
    }
}

// --- String output ----------------------------------------------------------

// draw_text may be called several times. The per-character loop lives
// in the non-inline _dt_loop, which the compiler places exactly once
// (labels in it are safe). An inline labeled loop would not be safe:
// inline fn labels are section-global symbols, so two inlined copies
// of a labeled loop share the label and jump into each other. A
// do-while would also not work: its back-jump is a relative JR with a
// 128-byte reach, and this loop body is longer.
//
// State across the _dt_loop call: _cursor_x, _cursor_y,
// _font_current, _draw_text_len (RAM); DE (string pointer, register).
//
// Precondition: len >= 1.

inline fn draw_text(x, y, str, len) {
    gotoxy(x, y)
    // String length counter.
    assign(_draw_text_len, len)
    // DE = pointer to the start of the string. Advanced by inc_de at
    // the end of each iteration. (ld_de #str emits a relocation to
    // the array const's ROM address.)
    ld_de #str
    // Process every character (single-copy loop, returns via RET).
    _dt_loop()
}

// Per-character loop for draw_text. Single copy in ROM (non-inline
// fn), so its labels cannot collide. Reads the state set up by
// draw_text (see its comment). Ends with an implicit RET.
fn _dt_loop() {
    'dt_loop:
    // Read the current character at (DE).
    ld_a_de
    ld_addr (_putchar_char)

    // Tile index: _tile_remap[char] when the entry is set, else the
    // legacy char + first_tile. The result lands in _putchar_char.
    // Runs first: the remap lookup uses HL.
    ld_a (_putchar_char)
    cp #128
    if (carry) { jp 'dt_remap' }
    jp 'dt_legacy'
    'dt_remap:
    cp #0
    if (zero) { jp 'dt_remap_done' }
    ld_addr (_ft_outer)
    ld_hl #_tile_remap
    do {
        inc_hl
        ld_a (_ft_outer)
        dec
        ld_addr (_ft_outer)
    } while (not zero)
    'dt_remap_done:
    ld_a_hl
    cp #0xFF
    if (zero) { jp 'dt_legacy' }
    ld_addr (_putchar_char)
    jp 'dt_tile_done'
    'dt_legacy:
    // Legacy: _putchar_char = _putchar_char + first_tile.
    ld_a (_font_current + 2)
    cp #0
    if (zero) { jp 'dt_tile_done' }
    ld_a (_font_current + 2)
    ld_addr (_ft_outer)
    do {
        ld_a (_putchar_char)
        add #1
        ld_addr (_putchar_char)
        ld_a (_ft_outer)
        dec
        ld_addr (_ft_outer)
    } while (not zero)
    'dt_tile_done:

    // Compute tile map address and write.
    ld_hl #0x9800
    // HL += _cursor_y * 32 (skipped when _cursor_y is 0).
    ld_a (_cursor_y)
    cp #0
    if (zero) { jp 'dt_y_done' }
    ld_addr (_ft_outer)
    do {
        ld #32
        ld_addr (_ft_inner)
        do {
            inc_hl
            ld_a (_ft_inner)
            dec
            ld_addr (_ft_inner)
        } while (not zero)
        ld_a (_ft_outer)
        dec
        ld_addr (_ft_outer)
    } while (not zero)
    'dt_y_done:
    // HL += _cursor_x (skipped when _cursor_x is 0).
    ld_a (_cursor_x)
    cp #0
    if (zero) { jp 'dt_x_done' }
    ld_addr (_ft_outer)
    do {
        inc_hl
        ld_a (_ft_outer)
        dec
        ld_addr (_ft_outer)
    } while (not zero)
    'dt_x_done:
    // _putchar_char holds the tile index. Write it to (HL) via ldi.
    ld_a (_putchar_char)
    ldi
    // Advance the cursor X; wrap to the next row at column 32.
    ld_a (_cursor_x)
    inc
    ld_addr (_cursor_x)
    cp #32
    if (zero) {
        assign(_cursor_x, 0)
        ld_a (_cursor_y)
        inc
        ld_addr (_cursor_y)
    }

    // Advance DE (string pointer).
    inc_de
    // Decrement length counter; loop while it is not zero.
    ld_a (_draw_text_len)
    dec
    ld_addr (_draw_text_len)
    if (not zero) { jp 'dt_loop' }
    'dt_done:
    nop
}

// --- Clear screen -----------------------------------------------------------

inline fn cls() {
    ld_hl #0x9800
    // Clear 1024 bytes (32x32 tile map) = 4 * 256.
    ld #4
    ld_addr (_ft_outer)
    do {
        ld #0
        ld_addr (_ft_inner)
        do {
            ld #0
            ldi
            ld_a (_ft_inner)
            dec
            ld_addr (_ft_inner)
        } while (not zero)
        ld_a (_ft_outer)
        dec
        ld_addr (_ft_outer)
    } while (not zero)
    assign(_cursor_x, 0)
    assign(_cursor_y, 0)
}

// --- Font loading (Game Boy / SM83) -----------------------------------------

inline fn font_load(font) {
    // Store the font data pointer and first tile in _font_current.
    // With the compiler fix, lo!/hi! of font.data (a struct field
    // pointing to an array const) now emits relocations instead of
    // resolving to the array length.
    ld #lo!(font.data)
    ld_addr (_font_current + 0)
    ld #hi!(font.data)
    ld_addr (_font_current + 1)
    // Capture the current first-free-tile as this font's first_tile.
    // font_first_free_tile is a RAM variable, so load its *value* with
    // ld_a (an address load); `ld #var` would emit the address, not the value.
    ld_a (font_first_free_tile)
    ld_addr (_font_current + 2)
    // Load tiles to VRAM with 1bpp->2bpp expansion.
    _font_load_tiles(font_first_free_tile, font.tile_count, font.data)
    // Advance first_free_tile by tile_count (a loop, since there is no
    // adc). ld #font.tile_count loads the const count as an immediate
    // (ld_a (font.tile_count) would load from memory address count).
    ld_a (font_first_free_tile)
    ld_addr (_ft_outer)
    ld #font.tile_count
    ld_addr (_ft_inner)
    cp #0
    if (zero) { jp 'gb_ft_done' }
    do {
        ld_a (_ft_outer)
        add #1
        ld_addr (_ft_outer)
        ld_a (_ft_inner)
        dec
        ld_addr (_ft_inner)
    } while (not zero)
    'gb_ft_done:
    ld_a (_ft_outer)
    ld_addr (font_first_free_tile)
    // Fill _tile_remap[c] = first_tile + enc[c] for c = 0..127 so
    // draw_text uses the encoding table. ENCODE_NONE: enc[c] = c.
    // Otherwise the table starts at font.data + 2 (the same offset
    // for 128 and 256 encodings).
    ld_de #font.data
    ld_a_de
    and #2
    ld_addr (_putchar_char)
    // DE = encoding table start (font.data + 2). Unused for
    // ENCODE_NONE.
    inc_de
    inc_de
    ld #0
    ld_addr (_ft_inner)
    'fl_c:
    ld_a (_putchar_char)
    cp #0
    if (zero) { jp 'fl_c_table' }
    // ENCODE_NONE: tile = c.
    ld_a (_ft_inner)
    ld_addr (_ft_outer)
    jp 'fl_sum'
    'fl_c_table:
    // tile = enc[c].
    ld_a_de
    inc_de
    ld_addr (_ft_outer)
    'fl_sum:
    // _ft_outer += first_tile. The loop counters use
    // _draw_text_ptr_lo so the mode byte in _putchar_char survives.
    ld_a (_font_current + 2)
    cp #0
    if (zero) { jp 'fl_hl' }
    ld_addr (_draw_text_ptr_lo)
    do {
        ld_a (_ft_outer)
        add #1
        ld_addr (_ft_outer)
        ld_a (_draw_text_ptr_lo)
        dec
        ld_addr (_draw_text_ptr_lo)
    } while (not zero)
    'fl_hl:
    // HL = _tile_remap + c.
    ld_hl #_tile_remap
    ld_a (_ft_inner)
    cp #0
    if (zero) { jp 'fl_write' }
    ld_addr (_draw_text_ptr_lo)
    do {
        inc_hl
        ld_a (_draw_text_ptr_lo)
        dec
        ld_addr (_draw_text_ptr_lo)
    } while (not zero)
    'fl_write:
    // _tile_remap[c] = first_tile + tile.
    ld_a (_ft_outer)
    ldi
    // c++ (128 entries).
    ld_a (_ft_inner)
    inc
    cp #128
    if (zero) { jp 'fl_done' }
    ld_addr (_ft_inner)
    jp 'fl_c'
    'fl_done:
    // A label must be followed by a statement; a bare label at the
    // end of a function body does not parse.
    nop
}

// --- Subset font loading ------------------------------------------------------
//
// font_load_string loads only the glyphs used by str into VRAM, one
// tile slot per character (a duplicate character gets a second copy,
// so the slot count equals the string length). Each glyph lands in a
// fresh slot starting at font_first_free_tile + 1, and
// _tile_remap[char] records the slot. Slot 0 stays blank: cls()
// fills the tile map with tile 0. The data pointer and base tile
// are stored in _font_current, so draw_text can be called right
// after.
//
// Only character codes below 0x80 are supported (the remap table is
// 128 entries). Call font_init_remap before the first load.
//
// font_load_string may be called several times. The per-character
// loop lives in the non-inline _fls_loop, which the compiler places
// exactly once (labels in it are safe). An inline labeled loop would
// not be safe: inline fn labels are section-global symbols, so two
// inlined copies of a labeled loop share the label and jump into each
// other. A do-while would also not work: its back-jump is a relative
// JR with a 128-byte reach, and this loop body is longer.
//
// State across the _fls_loop call: _font_current, _fls_slot,
// _draw_text_len (RAM); DE (string pointer, register).
//
// Precondition: len >= 1.

inline fn font_load_string(font, str, len) {
    // Slot 0 of the pattern table stays blank: cls() fills the tile
    // map with tile 0. Start glyph slots at font_first_free_tile + 1
    // so the first loaded glyph never lands in slot 0.
    ld_a (font_first_free_tile)
    inc
    ld_addr (_font_current + 2)
    // Store the font data pointer and base tile in _font_current.
    ld #lo!(font.data)
    ld_addr (_font_current + 0)
    ld #hi!(font.data)
    ld_addr (_font_current + 1)
    // Slot counter (0-based within this font).
    ld #0
    ld_addr (_fls_slot)
    // String cursor and length counter.
    ld_de #str
    ld #len
    ld_addr (_draw_text_len)
    // Turn the LCD off before writing VRAM. The caller turns the LCD
    // back on after all text is drawn (same convention as font_load).
    ld #0
    ldh (LCD::CONTROL)
    // Load every character's glyph (single-copy loop, returns via
    // RET).
    _fls_loop()
    // Advance font_first_free_tile by the slots used, plus the
    // reserved blank slot 0 (the base was set to
    // font_first_free_tile + 1).
    ld_a (_fls_slot)
    cp #0
    if (not zero) {
        ld_addr (_ft_inner)
        ld_a (font_first_free_tile)
        ld_addr (_ft_outer)
        do {
            ld_a (_ft_outer)
            add #1
            ld_addr (_ft_outer)
            ld_a (_ft_inner)
            dec
            ld_addr (_ft_inner)
        } while (not zero)
        ld_a (_ft_outer)
        add #1
        ld_addr (font_first_free_tile)
    }
}

// Per-character loop for font_load_string. Single copy in ROM
// (non-inline fn), so its labels cannot collide. Reads the state set
// up by font_load_string (see its comment). Ends with an implicit RET.
fn _fls_loop() {
    'fls_char:
    // A = char.
    ld_a_de
    inc_de
    ld_addr (_putchar_char)
    // BC = font.data, from _font_current (set by font_load_string;
    // the font parameter is not visible here — this is a single-copy
    // non-inline fn, not an inline expansion). BC is big-endian: B
    // takes the high byte, C the low byte.
    ld_a (_font_current + 1)
    ld_ba
    ld_a (_font_current + 0)
    ld_ca
    // Read the flags byte before advancing BC.
    ld_a_bc
    and #2
    ld_addr (_draw_text_ptr_hi)
    ld_a_bc
    and #1
    ld_addr (_ft_inner)
    inc_bc
    inc_bc
    ld_a (_draw_text_ptr_hi)
    cp #0
    if (zero) { jp 'fls_tile_table' }
    // ENCODE_NONE: tile = char.
    ld_a (_putchar_char)
    ld_addr (_ft_outer)
    jp 'fls_src'
    'fls_tile_table:
    // BC += char.
    ld_a (_putchar_char)
    cp #0
    if (zero) { jp 'fls_tile' }
    ld_addr (_draw_text_ptr_lo)
    do {
        inc_bc
        ld_a (_draw_text_ptr_lo)
        dec
        ld_addr (_draw_text_ptr_lo)
    } while (not zero)
    'fls_tile:
    // _ft_outer = tile.
    ld_a_bc
    ld_addr (_ft_outer)
    'fls_src:
    // BC = tile data start + tile*8. The tile data starts after the
    // encoding table (256, 128, or 0 bytes). BC is big-endian: B
    // takes the high byte, C the low byte.
    ld_a (_font_current + 1)
    ld_ba
    ld_a (_font_current + 0)
    ld_ca
    inc_bc
    inc_bc
    ld_a (_draw_text_ptr_hi)
    cp #0
    if (zero) { jp 'fls_bit0' }
    jp 'fls_ts_done'
    'fls_bit0:
    ld_a (_ft_inner)
    cp #0
    if (zero) { jp 'fls_ts256' }
    // ENCODE_128: skip 128 table bytes.
    ld #128
    ld_addr (_draw_text_ptr_lo)
    do {
        inc_bc
        ld_a (_draw_text_ptr_lo)
        dec
        ld_addr (_draw_text_ptr_lo)
    } while (not zero)
    jp 'fls_ts_done'
    'fls_ts256:
    // ENCODE_256: skip 256 table bytes (counter 0 wraps to 255).
    ld #0
    ld_addr (_draw_text_ptr_lo)
    do {
        inc_bc
        ld_a (_draw_text_ptr_lo)
        dec
        ld_addr (_draw_text_ptr_lo)
    } while (not zero)
    'fls_ts_done:
    // BC += tile*8.
    ld_a (_ft_outer)
    cp #0
    if (zero) { jp 'fls_copy' }
    ld_addr (_ft_inner)
    do {
        ld #8
        ld_addr (_draw_text_ptr_hi)
        do {
            inc_bc
            ld_a (_draw_text_ptr_hi)
            dec
            ld_addr (_draw_text_ptr_hi)
        } while (not zero)
        ld_a (_ft_inner)
        dec
        ld_addr (_ft_inner)
    } while (not zero)
    'fls_copy:
    // HL = 0x8000 + (base + slot) * 16.
    ld_a (_font_current + 2)
    ld_addr (_ft_outer)
    ld_a (_fls_slot)
    cp #0
    if (zero) { jp 'fls_hl' }
    ld_addr (_ft_inner)
    do {
        ld_a (_ft_outer)
        add #1
        ld_addr (_ft_outer)
        ld_a (_ft_inner)
        dec
        ld_addr (_ft_inner)
    } while (not zero)
    'fls_hl:
    ld_hl #0x8000
    ld_a (_ft_outer)
    cp #0
    if (zero) { jp 'fls_rows' }
    ld_addr (_ft_inner)
    do {
        ld #16
        ld_addr (_draw_text_ptr_hi)
        do {
            inc_hl
            ld_a (_draw_text_ptr_hi)
            dec
            ld_addr (_draw_text_ptr_hi)
        } while (not zero)
        ld_a (_ft_inner)
        dec
        ld_addr (_ft_inner)
    } while (not zero)
    'fls_rows:
    // Copy 8 one-bit rows to VRAM, expanded to 2bpp (plane0 = plane1
    // = row, ink -> colour 3, paper -> colour 0). BC is the 1bpp
    // source and advances one byte per row.
    ld #8
    ld_addr (_ft_inner)
    do {
        ld_a_bc
        inc_bc
        ldi
        ldi
        ld_a (_ft_inner)
        dec
        ld_addr (_ft_inner)
    } while (not zero)
    // _tile_remap[char] = base + slot.
    ld_hl #_tile_remap
    ld_a (_putchar_char)
    cp #0
    if (zero) { jp 'fls_rm' }
    ld_addr (_ft_inner)
    do {
        inc_hl
        ld_a (_ft_inner)
        dec
        ld_addr (_ft_inner)
    } while (not zero)
    'fls_rm:
    ld_a (_ft_outer)
    ldi
    // slot++.
    ld_a (_fls_slot)
    inc
    ld_addr (_fls_slot)
    // len--
    ld_a (_draw_text_len)
    dec
    ld_addr (_draw_text_len)
    if (not zero) { jp 'fls_char' }
    'fls_done:
    nop
}

inline fn font_register(font) {
    ld #lo!(font.data)
    ld_addr (_font_current + 0)
    ld #hi!(font.data)
    ld_addr (_font_current + 1)
    assign(_font_current + 2, 0)
}

inline fn font_set(handle) {
    ld_a (handle + 0)
    ld_addr (_font_current + 0)
    ld_a (handle + 1)
    ld_addr (_font_current + 1)
    ld_a (handle + 2)
    ld_addr (_font_current + 2)
}