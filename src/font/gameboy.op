//! Font Text Display — Game Boy
//!
//! Text display functions for the Game Boy and Game Boy Color. Writes
//! tile indices to the tile map at 0x9800. The cursor position is
//! tracked in `_cursor_x` and `_cursor_y`.

use super::types::*;
use super::ram::*;
use std::machine::*;

// --- Temp variables ---------------------------------------------------------

_putchar_char: u8;
_draw_text_ptr: pointer;
_draw_text_len: u8;

// --- Game Boy runtime tile loader -------------------------------------------

inline fn _font_load_tiles(first, count, data) {
    turn_video_off()
    ld h, #0x80
    ld l, #0x00
    ld_a (count)
    ld b, a
    'gb_tile_loop:
    ld a, #8
    ld c, a
    'gb_row_loop:
    ld a, #0
    ld (hl), a
    inc_hl
    ld a, #0
    ld (hl), a
    inc_hl
    ld a, c
    dec
    ld c, a
    if (not zero) { jp 'gb_row_loop }
    ld a, b
    dec
    ld b, a
    if (not zero) { jp 'gb_tile_loop }
    turn_video_on()
}

// --- Cursor positioning -----------------------------------------------------

inline fn gotoxy(x, y) {
    assign(_cursor_x, x)
    assign(_cursor_y, y)
}

// --- Helper: increment H (for carry from L) --------------------------------

inline fn inc_h() {
    ld a, h
    inc
    ld h, a
}

// --- Character output -------------------------------------------------------
//
// putchar writes the character in _putchar_char to the tile map at the
// cursor position. The tile index is _putchar_char + first_tile.
//
// The tile map address is TILE_MAP_0_ADDRESS + _cursor_y * 32 + _cursor_x.
// We compute this by starting at 0x9800, adding 32 for each row, then
// adding 1 for each column.

inline fn putchar(c) {
    assign(_putchar_char, c)

    // Set HL = 0x9800.
    ld h, #0x98
    ld l, #0x00

    // Add _cursor_y * 32 to HL.
    ld_a (_cursor_y)
    ld b, a
    'pc_y_loop:
    if (zero) { jp 'pc_y_done }
    ld a, l
    add #32
    ld l, a
    if (not carry) { jp 'pc_y_skip }
    inc_h()
    'pc_y_skip:
    ld a, b
    dec
    ld b, a
    jp 'pc_y_loop
    'pc_y_done:

    // Add _cursor_x to HL by adding 1 x times.
    ld_a (_cursor_x)
    ld b, a
    'pc_x_loop:
    if (zero) { jp 'pc_x_done }
    ld a, l
    add #1
    ld l, a
    if (not carry) { jp 'pc_x_skip }
    inc_h()
    'pc_x_skip:
    ld a, b
    dec
    ld b, a
    jp 'pc_x_loop
    'pc_x_done:

    // Write the tile index: _putchar_char + first_tile.
    // A = first_tile + char, computed by adding 1 char times.
    ld_a (_font_current + 2)
    ld b, a
    ld_a (_putchar_char)
    ld c, a
    'pc_add_loop:
    if (zero) { jp 'pc_add_done }
    ld a, b
    add #1
    ld b, a
    ld a, c
    dec
    ld c, a
    jp 'pc_add_loop
    'pc_add_done:
    ld a, b
    ld (hl), a

    // Advance the cursor X. Wrap at 32.
    ld_a (_cursor_x)
    inc
    ld (_cursor_x), a
    cp #32
    if (carry) { jp 'pc_done }
    assign(_cursor_x, 0)
    ld_a (_cursor_y)
    inc
    ld (_cursor_y), a
    'pc_done:
    nop
}

// --- String output ----------------------------------------------------------

inline fn draw_text(x, y, str, len) {
    gotoxy(x, y)
    ld a, #lo!(str)
    ld (_draw_text_ptr + 0), a
    ld a, #hi!(str)
    ld (_draw_text_ptr + 1), a
    assign(_draw_text_len, len)

    ld_a (_draw_text_ptr + 1)
    ld d, a
    ld_a (_draw_text_ptr + 0)
    ld e, a
    ld_a (_draw_text_len)
    ld b, a
    'dt_loop:
    if (zero) { jp 'dt_done }
    ld a, (de)
    ld (_putchar_char), a

    // Inline putchar body:
    ld h, #0x98
    ld l, #0x00
    ld_a (_cursor_y)
    ld c, a
    'dt_y_loop:
    if (zero) { jp 'dt_y_done }
    ld a, l
    add #32
    ld l, a
    if (not carry) { jp 'dt_y_skip }
    inc_h()
    'dt_y_skip:
    ld a, c
    dec
    ld c, a
    jp 'dt_y_loop
    'dt_y_done:
    ld_a (_cursor_x)
    ld c, a
    'dt_x_loop:
    if (zero) { jp 'dt_x_done }
    ld a, l
    add #1
    ld l, a
    if (not carry) { jp 'dt_x_skip }
    inc_h()
    'dt_x_skip:
    ld a, c
    dec
    ld c, a
    jp 'dt_x_loop
    'dt_x_done:
    ld_a (_font_current + 2)
    ld b, a
    ld_a (_putchar_char)
    ld c, a
    'dt_add_loop:
    if (zero) { jp 'dt_add_done }
    ld a, b
    add #1
    ld b, a
    ld a, c
    dec
    ld c, a
    jp 'dt_add_loop
    'dt_add_done:
    ld a, b
    ld (hl), a
    ld_a (_cursor_x)
    inc
    ld (_cursor_x), a
    cp #32
    if (carry) { jp 'dt_pc_done }
    assign(_cursor_x, 0)
    ld_a (_cursor_y)
    inc
    ld (_cursor_y), a
    'dt_pc_done:
    nop

    // Advance DE.
    ld a, e
    inc
    ld e, a
    if (not zero) { jp 'dt_de_done }
    ld a, d
    inc
    ld d, a
    'dt_de_done:

    // Decrement counter.
    ld a, b
    dec
    ld b, a
    jp 'dt_loop
    'dt_done:
    nop
}

// --- Clear screen -----------------------------------------------------------

inline fn cls() {
    ld h, #0x98
    ld l, #0x00
    ld a, #0
    ld b, a
    'cls_outer:
    ld a, #0
    ld c, a
    'cls_inner:
    ld a, #0
    ld (hl), a
    inc_hl
    ld a, c
    inc
    ld c, a
    if (not zero) { jp 'cls_inner }
    ld a, b
    inc
    ld b, a
    cp #4
    if (not zero) { jp 'cls_outer }

    assign(_cursor_x, 0)
    assign(_cursor_y, 0)
}

// --- Font loading (Game Boy / SM83) -----------------------------------------

inline fn font_load(font) {
    ld a, #lo!(font.data)
    ld (_font_current + 0), a
    ld a, #hi!(font.data)
    ld (_font_current + 1), a
    assign(_font_current + 2, font_first_free_tile)
    _font_load_tiles(font_first_free_tile, font.tile_count, font.data)
    // Advance first_free_tile (SM83 has no adc r — use loop).
    ld_a (font_first_free_tile)
    ld b, a
    ld_a (font.tile_count)
    ld c, a
    'gb_add_loop:
    if (zero) { jp 'gb_add_done }
    ld a, b
    add #1
    ld b, a
    ld a, c
    dec
    ld c, a
    jp 'gb_add_loop
    'gb_add_done:
    ld a, b
    ld (font_first_free_tile), a
}

inline fn font_register(font) {
    ld a, #lo!(font.data)
    ld (_font_current + 0), a
    ld a, #hi!(font.data)
    ld (_font_current + 1), a
    assign(_font_current + 2, 0)
}

inline fn font_set(handle) {
    ld_a (handle + 0)
    ld (_font_current + 0), a
    ld_a (handle + 1)
    ld (_font_current + 1), a
    ld_a (handle + 2)
    ld (_font_current + 2), a
}