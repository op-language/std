//! Game Boy Types
//!
//! Enums for joypad buttons, LCD status modes, and interrupt flags for
//! the Nintendo Game Boy and Game Boy Color.

// --- joypad buttons --------------------------------------------------------

enum JOYPAD_BUTTON {
    A      = 0x01,
    B      = 0x02,
    SELECT = 0x04,
    START  = 0x08,
    RIGHT  = 0x10,
    LEFT   = 0x20,
    UP     = 0x40,
    DOWN   = 0x80,
}

// --- LCD status modes ------------------------------------------------------

enum LCD_STATUS {
    HBLANK   = 0,
    VBLANK   = 1,
    OAM      = 2,
    TRANSFER = 3,
}

// --- DMG monochrome shades --------------------------------------------------
//
// The DMG background palette register (0xFF47) holds four 2-bit shade
// values packed into one byte. Each shade selects one of four gray
// levels. Bits 0-1 set the shade for color 0, bits 2-3 for color 1,
// bits 4-5 for color 2, and bits 6-7 for color 3.

enum DMG_SHADE {
    WHITE      = 0x00,
    LIGHT_GRAY = 0x01,
    DARK_GRAY  = 0x02,
    BLACK      = 0x03,
}

// --- interrupt flags -------------------------------------------------------

enum INTERRUPT {
    VBLANK  = 0x01,
    LCD     = 0x02,
    TIMER   = 0x04,
    SERIAL  = 0x08,
    JOYPAD  = 0x10,
}