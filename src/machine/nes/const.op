//! NES Constants
//!
//! Conditional constants, PPU control bitmasks, status flags, and
//! palette and name table addresses for the Nintendo Entertainment System.

// --- conditional constants -------------------------------------------------

#[cfg(variant = "ntsc")]
const REFRESH_HZ: u8 = 60;

#[cfg(variant = "pal")]
const REFRESH_HZ: u8 = 50;

// --- PPU control register bitmasks -----------------------------------------

const CR_NMI: u8            = %10000000;
const CR_BACKVISIBLE: u8    = %00001000;
const CR_BACKNOCLIP: u8     = %00000010;
const CR_SPRITESVISIBLE: u8 = %00010000;

// --- PPU status flags ------------------------------------------------------

const ST_VBLANK: u8 = %10000000;

// --- palette and name table addresses --------------------------------------

const PAL_ADDRESS: u16          = 0x3F00;
const NAME_TABLE_0_ADDRESS: u16 = 0x2000;