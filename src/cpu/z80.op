//! Zilog Z80 CPU
//!
//! Registers, condition keywords, opcode mnemonics, addressing modes,
//! and interrupt names for the Zilog Z80 CPU. The Z80 extends the Intel
//! 8080 instruction set.

// --- Registers -------------------------------------------------------------
//
// The lib defines the 8-bit registers, 16-bit register pairs, index
// registers, stack pointer, program counter, and alternate register set.

enum CPU_REG {
    a   = 0,
    b   = 1,
    c   = 2,
    d   = 3,
    e   = 4,
    h   = 5,
    l   = 6,
    af  = 7,
    bc  = 8,
    de  = 9,
    hl  = 10,
    ix  = 11,
    iy  = 12,
    sp  = 13,
    pc  = 14,
    af2 = 15,
    bc2 = 16,
    de2 = 17,
    hl2 = 18,
}

// --- Condition keywords ----------------------------------------------------
//
// The lib defines the condition keywords for if, while, and do-while
// tests. The modifier keywords is, has, no, and not may prefix a
// condition.

enum COND {
    not_zero        = 0,
    zero            = 1,
    no_carry        = 2,
    carry           = 3,
    parity_even     = 4,
    parity_odd      = 5,
    sign_positive   = 6,
    sign_negative   = 7,
}

// --- Opcode mnemonics ------------------------------------------------------
//
// The Z80 opcode table lists each mnemonic.

enum OPCODE {
    LD,
    PUSH,
    POP,
    EX,
    EXX,
    LDI,
    LDIR,
    LDD,
    LDDR,
    CPI,
    CPIR,
    CPD,
    CPDR,
    ADD,
    ADC,
    SUB,
    SBC,
    AND,
    OR,
    XOR,
    CP,
    INC,
    DEC,
    DAA,
    CPL,
    NEG,
    CCF,
    SCF,
    NOP,
    HALT,
    DI,
    EI,
    IM,
    RLC,
    RL,
    RRC,
    RR,
    SLA,
    SRA,
    SLL,
    SRL,
    RLD,
    RRD,
    RLCA,
    RLA,
    RRCA,
    RRA,
    JP,
    JR,
    DJNZ,
    CALL,
    RET,
    RETI,
    RETN,
    RST,
    IN,
    OUT,
    INI,
    INIR,
    IND,
    INDR,
    OUTI,
    OTIR,
    OUTD,
    OTDR,
    BIT,
    SET,
    RES,
}

// --- Undocumented opcodes --------------------------------------------------
//
// The Z80 has undocumented opcodes that real hardware executes. The
// lib defines them as legal mnemonics. A program may use them with
// #[cfg(feature = "undocumented")].

#[cfg(feature = "undocumented")]
enum UNDOC_OPCODE {
    SLL,
}

// --- Addressing modes ------------------------------------------------------
//
// The lib defines the addressing mode prefix names.

enum ADDR_MODE {
    imm,
    abs,
    ind,
    idx,
    rel,
    bit,
}

// --- Interrupt vectors -----------------------------------------------------
//
// The Z80 supports interrupt modes 0, 1, and 2. The lib defines the
// names nmi, irq, and rst for #[interrupt(...)].

enum INTERRUPT {
    nmi,
    irq,
    rst,
}

// Re-export the enum variants so `cpu::a`, `cpu::LD`, etc. work after
// `use std::*;` or `use std::cpu::*;`.
pub use CPU_REG::*;
pub use COND::*;
pub use OPCODE::*;
pub use ADDR_MODE::*;
pub use INTERRUPT::*;